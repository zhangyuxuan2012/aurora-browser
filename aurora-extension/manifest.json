{
  "manifest_version": 3,
  "name": "极光快导",
  "version": "1.2.0",
  "description": "极光快导：分屏导航+沉浸式阅读+防弹窗+隐私保护。阅读模式2.0（智能正文/目录/字体调节/主题）、划词查询、稍后阅读。",
  "permissions": [
    "storage",
    "browsingData",
    "tabs",
    "notifications",
    "contextMenus",
    "scripting",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "极光快导",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "sidepanel.html",
        "sidepanel.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}