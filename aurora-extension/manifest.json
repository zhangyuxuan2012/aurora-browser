{
  "manifest_version": 3,
  "name": "极光快导",
  "version": "1.1.0",
  "description": "纯净防弹窗 + 201站导航 + 分屏侧边栏 + 隐私保护，极光浏览器核心功能扩展版。可安装到 Chrome / Edge / 360 / Brave 等 Chromium 内核浏览器。 内置一键 AI 总结：本地算法提炼长文本核心要点，不联网、不上传、免费。 v1.1.0新增：阅读模式（去广告纯净阅读）、暗黑模式、网页截图、自定义快捷网址。",
  "permissions": [
    "storage",
    "browsingData",
    "tabs",
    "notifications",
    "contextMenus",
    "scripting",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "极光快导",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "sidepanel.html",
        "sidepanel.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}